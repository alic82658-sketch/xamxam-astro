---
import { formatActeurCategory } from '../utils/formatters';

const { name, description, category, city, logo, slug } = Astro.props;
const href = `/ecosysteme/${slug}/`;
const logoAlt = `Logo de ${name}`;
---

<article class="acteur-card card">
  <div class="card-top">
    <span class="pill">{formatActeurCategory(category)}</span>
    {logo ? <img src={logo} alt={logoAlt} loading="lazy" /> : null}
  </div>
  <h3>{name}</h3>
  <p>{description}</p>
  <div class="meta-row">
    <span>{city}</span>
    <a href={href}>Voir le profil →</a>
  </div>
</article>

<style>
  .acteur-card { display: flex; flex-direction: column; gap: 0.75rem; min-height: 100%; }
  .card-top { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; }
  .card-top img { width: 48px; height: 48px; object-fit: cover; border-radius: 6px; }
  .meta-row { display: flex; justify-content: space-between; gap: 0.75rem; color: var(--color-muted); font-size: 0.95rem; margin-top: auto; }
</style>
