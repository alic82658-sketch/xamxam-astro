---
// `number` : numéro au format international sans "+" ni espaces (ex. "221771234567").
// Sans `number`, le bouton utilise le numéro du site (Teranga Web Digital / xamxam.ai).
const { label = 'Discutons sur WhatsApp', number = '' } = Astro.props;
const href = number ? `https://wa.me/${number}` : 'https://wa.me/221774952105';
---

<a class="button wa" href={href} target="_blank" rel="noreferrer" aria-label="Contacter sur WhatsApp">
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.149-.174.199-.297.298-.495.099-.198.05-.372-.025-.521-.075-.149-.669-1.611-.916-2.206-.241-.579-.486-.501-.669-.51-.173-.008-.372-.01-.571-.01-.198 0-.521.074-.792.372-.272.298-1.04 1.016-1.04 2.479 0 1.463 1.065 2.875 1.213 3.073.149.198 2.097 3.2 5.076 4.487.709.306 1.262.49 1.694.627.712.227 1.36.195 1.872.118.572-.085 1.758-.719 2.006-1.414.248-.695.248-1.29.174-1.414-.074-.123-.272-.198-.57-.347z"/>
  </svg>
  {label}
</a>

<style>
  .button.wa { display: inline-flex; align-items: center; gap: 0.6rem; }
  .button.wa svg { width: 1.1rem; height: 1.1rem; }
</style>
