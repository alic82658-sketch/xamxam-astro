---
import { formatFrenchDate } from '../utils/formatters';

const { title, description, publishDate, category, slug, image, imageAlt = title } = Astro.props;
const href = `/blog/${slug}/`;
---

<article class="article-card card">
  <div class="card-accent"></div>
  <div class="card-body">
    <span class="pill">{category}</span>
    <h3>{title}</h3>
    <p>{description}</p>
    <div class="meta-row">
      <span>{formatFrenchDate(publishDate)}</span>
      <a href={href}>Lire l’article →</a>
    </div>
  </div>
</article>

<style>
  .article-card {
    display: flex;
    gap: 1rem;
    padding: 0;
    overflow: hidden;
    max-width: 380px;
    width: 100%;
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }
  .article-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(22, 24, 29, 0.08);
    border-color: rgba(22,24,29,0.12);
  }
  .card-accent {
    width: 4px;
    background: var(--vert);
    flex-shrink: 0;
    align-self: stretch;
  }
  .card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }
  .article-card .pill {
    background: transparent;
    border: 1px solid var(--or);
    color: #8A5A0F;
    padding: 0.24rem 0.46rem;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .meta-row {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: center;
    color: var(--color-muted);
    font-size: 0.95rem;
    margin-top: auto;
  }
</style>
