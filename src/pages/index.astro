---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ActeurCard from '../components/ActeurCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import MotifPattern from '../components/MotifPattern.astro';
import NeuralBrain from '../components/NeuralBrain.astro';
import { formatCategory } from '../utils/formatters';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()).slice(0, 3);
const acteurs = (await getCollection('acteurs', ({ data }) => !data.draft && data.featured)).slice(0, 4);
---

<BaseLayout title="xamxam.ai" description="Le média de référence sur l’intelligence artificielle au Sénégal, avec l’ambition de rayonner sur l’Afrique francophone.">
  <section class="hero container">
    <div class="hero-copy reveal">
      <p class="pill hero-pill">MÉDIA IA SÉNÉGAL</p>
      <h1 class="hero-title"><span class="hero-line">L’intelligence artificielle</span><span class="hero-line hero-line--second"><span class="title-underline">au Sénégal</span></span></h1>
      <p class="lead">Outils, acteurs, guides et actualités de l’écosystème IA sénégalais.</p>
      <div class="hero-actions">
        <a class="button primary" href="/blog">Explorer le blog <span class="arrow">→</span></a>
        <a class="button secondary" href="/ecosysteme">Découvrir l’écosystème</a>
      </div>
      <div class="hero-credibility">
        <div class="credibility-line"></div>
        <p><span class="credibility-name">Malcom Ali Kassim</span> — édité depuis Dakar par l’équipe de Teranga Web Digital.</p>
      </div>
    </div>
    <div class="hero-visual reveal">
      <NeuralBrain />
    </div>
  </section>

  <div class="ticker" aria-label="Édition en continu">
    <div class="ticker-track">
      <span>L'ESSENTIEL — Outils IA testés depuis Dakar ✦ Guides pratiques en français ✦ L'écosystème tech sénégalais ✦ GEO & visibilité IA ✦ Interviews de créateurs sénégalais ✦</span>
      <span aria-hidden="true">L'ESSENTIEL — Outils IA testés depuis Dakar ✦ Guides pratiques en français ✦ L'écosystème tech sénégalais ✦ GEO & visibilité IA ✦ Interviews de créateurs sénégalais ✦</span>
    </div>
  </div>

  <section class="container">
    <div class="section-heading reveal">
      <div>
        <p class="section-number">01 — DERNIERS ARTICLES</p>
        <h2 class="section-title">Derniers articles</h2>
      </div>
      <a class="card-link" href="/blog">Voir tous les articles <span class="arrow">→</span></a>
    </div>
    <div class="featured-article reveal">
      <div class="featured-copy">
        <p class="pill featured-pill">À la une</p>
        <p class="pill category-pill">{formatCategory(articles[0]?.data.category || 'IA')}</p>
        <h3>{articles[0]?.data.title || 'L’actualité IA au Sénégal'}</h3>
        <p>{articles[0]?.data.description || 'Des analyses, des outils et des portraits pour mieux comprendre l’IA au Sénégal.'}</p>
        <div class="meta-row">
          <span>{articles[0] ? new Date(articles[0].data.publishDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) : 'À paraître'}</span>
          <span class="meta-separator">·</span>
          <a class="card-link" href={articles[0] ? `/blog/${articles[0].id}/` : '/blog'}>Lire l’article <span class="arrow">→</span></a>
        </div>
      </div>
      <div class="featured-visual">
        <MotifPattern dense={true} />
      </div>
    </div>
    <div class="featured-teaser reveal">
      <span class="featured-teaser__label">PROCHAINEMENT SUR XAMXAM</span>
      <div class="featured-teaser__pills">
        <span class="feature-pill">Comparatifs d’outils</span>
        <span class="feature-pill">Interviews de créateurs</span>
        <span class="feature-pill">Guides GEO & visibilité</span>
      </div>
    </div>
    <div class="grid three">
      {articles.slice(1).map((article) => (
        <ArticleCard title={article.data.title} description={article.data.description} publishDate={article.data.publishDate} category={formatCategory(article.data.category)} slug={article.id} image={article.data.image} imageAlt={article.data.imageAlt || article.data.title} />
      ))}
    </div>
  </section>

  <section class="section-surface section-surface--alt">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-number">02 — EXPLORER PAR THÈME</p>
          <h2 class="section-title">Explorer par thème</h2>
        </div>
      </div>
      <div class="grid two">
        <a class="theme-card tools card reveal" href="/blog/categorie/outils-et-pratiques">
          <div class="theme-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 4h6v6"></path>
              <path d="M10 20H4v-6"></path>
              <path d="M14 4l-8 8"></path>
              <path d="M10 20l8-8"></path>
            </svg>
          </div>
          <h3>Outils & Pratiques</h3>
          <p>Guides, cas d’usage et outils concrets à intégrer dans vos activités.</p>
        </a>
        <a class="theme-card afrique card reveal" href="/blog/categorie/ia-en-afrique">
          <div class="theme-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="8"></circle>
              <path d="M4 12h16"></path>
              <path d="M12 4c2.2 2.9 3.3 5.9 3.3 8s-1.1 5.1-3.3 8"></path>
              <path d="M12 4c-2.2 2.9-3.3 5.9-3.3 8s1.1 5.1 3.3 8"></path>
            </svg>
          </div>
          <h3>IA en Afrique</h3>
          <p>Analyses, acteurs et opportunités de l’intelligence artificielle sur le continent.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="container">
    <div class="section-heading reveal">
      <div>
        <p class="section-number">03 — L'ÉCOSYSTÈME IA</p>
        <h2 class="section-title">L’écosystème IA</h2>
      </div>
      <a class="card-link" href="/ecosysteme">Découvrir tous les acteurs <span class="arrow">→</span></a>
    </div>
    {acteurs.length > 0 ? (
      <div class="grid three">
        {acteurs.map((acteur) => (
          <ActeurCard name={acteur.data.name} description={acteur.data.description} category={acteur.data.category} city={acteur.data.city} logo={acteur.data.logo} slug={acteur.id} />
        ))}
      </div>
    ) : (
      <div class="ghost-grid">
        <article class="ghost-card reveal">
          <div class="ghost-pattern"><MotifPattern compact={true} /></div>
          <h3>Bientôt référencé</h3>
          <p>Une nouvelle fiche d’acteur apparaîtra ici très bientôt.</p>
        </article>
        <article class="ghost-card reveal">
          <div class="ghost-pattern"><MotifPattern compact={true} /></div>
          <h3>Bientôt référencé</h3>
          <p>Le réseau des initiatives IA se complète au fil des jours.</p>
        </article>
        <article class="ghost-card ghost-card--cta reveal">
          <div class="ghost-pattern"><MotifPattern compact={true} /></div>
          <h3>Référencer votre solution →</h3>
          <p>Ajoutez votre projet, votre équipe ou votre expertise à l’écosystème.</p>
        </article>
      </div>
    )}
  </section>

  <section class="section-surface section-surface--alt">
    <div class="container">
      <NewsletterForm />
    </div>
  </section>

  <Fragment slot="schema">
    <SchemaOrg type="WebSite" />
    <SchemaOrg type="Organization" />
  </Fragment>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: 2rem;
    align-items: start;
    padding: 4rem 0 0;
  }
  .hero-copy { max-width: 760px; }
  .hero-title {
    display: grid;
    gap: 0.2rem;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 0.95;
    margin-bottom: 1rem;
    color: var(--encre);
    opacity: 0;
    transform: translateY(16px);
    animation: heroFade 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .hero-line { display: block; }
  .hero-line--second { animation-delay: 0.15s; }
  .title-underline {
    display: inline-block;
    padding-bottom: 0.08em;
    border-bottom: 6px solid var(--or);
  }
  .hero-pill {
    opacity: 0;
    transform: translateY(16px);
    animation: heroFade 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.1s;
  }
  .hero .lead {
    opacity: 0;
    transform: translateY(16px);
    animation: heroFade 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.55s;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.6rem;
    opacity: 0;
    transform: translateY(16px);
    animation: heroFade 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.7s;
  }
  .hero-credibility {
    margin-top: 1.4rem;
    max-width: 34rem;
    opacity: 0;
    transform: translateY(16px);
    animation: heroFade 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.85s;
  }
  .credibility-line {
    width: 48px;
    height: 1px;
    background: #E7E4DC;
    margin-bottom: 0.8rem;
  }
  .hero-credibility p {
    margin: 0;
    font-size: 0.81rem;
    line-height: 1.6;
    color: var(--gris-texte);
  }
  .credibility-name {
    color: var(--encre);
    font-weight: 500;
  }
  .hero-visual {
    opacity: 0;
    transform: translateY(16px);
    animation: heroFade 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 1s;
  }
  .hero-pattern-shell {
    position: relative;
    background: radial-gradient(circle at center, rgba(14, 122, 95, 0.07) 0%, rgba(250, 249, 245, 0) 72%);
    border: 1px solid #E7E4DC;
    border-radius: 24px;
    padding: 1rem;
    min-height: 320px;
    overflow: hidden;
  }
  .hero-pattern-shell::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--fond) 0%, rgba(250,249,245,0) 20%, rgba(250,249,245,0) 80%, var(--fond) 100%);
    pointer-events: none;
  }
  .ticker {
    width: 100%;
    overflow: hidden;
    background: var(--encre);
    color: var(--fond);
    padding: 0.85rem 0;
    margin-top: 1.25rem;
  }
  .ticker-track {
    display: flex;
    gap: 1rem;
    white-space: nowrap;
    animation: marquee 40s linear infinite;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .ticker-track span {
    color: var(--fond);
  }
  .ticker-track span[aria-hidden='true'] {
    color: var(--or);
  }
  .ticker:hover .ticker-track { animation-play-state: paused; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1.4rem; }
  .section-number {
    color: var(--or);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    margin-bottom: 0.35rem;
    font-family: var(--font-display);
  }
  .section-heading a { color: var(--color-muted); }
  .featured-article {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
    padding: 1.35rem;
    background: var(--surface);
    border: 1px solid #E7E4DC;
    border-radius: 24px;
    box-shadow: 0 8px 24px rgba(22, 24, 29, 0.06);
  }
  .featured-copy h3 { font-size: 1.75rem; margin-bottom: 0.75rem; }
  .featured-pill {
    margin-bottom: 0.75rem;
    background: var(--or);
    color: #FFFFFF;
    border: none;
  }
  .category-pill {
    margin-left: 0.5rem;
    background: transparent;
    border: 1px solid var(--or);
    color: #8A5A0F;
  }
  .meta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; color: var(--gris-texte); }
  .meta-separator { color: var(--or); font-weight: 700; }
  .featured-visual {
    min-height: 220px;
    background: rgba(14, 122, 95, 0.05);
    border-radius: 20px;
    border: 1px solid rgba(14, 122, 95, 0.08);
    overflow: hidden;
    padding: 0.75rem;
  }
  .featured-teaser {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #E7E4DC;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1rem;
  }
  .featured-teaser__label {
    font-size: 0.69rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #5A5F66;
  }
  .featured-teaser__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .feature-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.8rem;
    border: 1px solid #E7E4DC;
    border-radius: 999px;
    color: var(--encre);
    background: transparent;
    font-size: 0.82rem;
  }
  .section-surface {
    background: transparent;
  }
  .section-surface--alt {
    background: #F5F3ED;
  }
  .theme-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 180px;
    background: var(--surface);
    border: 1px solid #E7E4DC;
    padding: 1.35rem 1.45rem;
    position: relative;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .theme-card::before { content: ''; position: absolute; left: -1px; top: 1.25rem; bottom: 1.25rem; width: 3px; border-radius: 999px; }
  .theme-card.tools::before { background: var(--vert); }
  .theme-card.afrique::before { background: var(--or); }
  .theme-card:hover { transform: translateY(-3px); border-color: rgba(22,24,29,0.12); box-shadow: 0 8px 24px rgba(22, 24, 29, 0.08); }
  .theme-icon {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    margin-bottom: 1rem;
  }
  .theme-card.tools .theme-icon { background: rgba(14, 122, 95, 0.1); color: var(--vert); }
  .theme-card.afrique .theme-icon { background: rgba(217, 154, 43, 0.1); color: var(--or); }
  .theme-icon svg { width: 20px; height: 20px; }
  .theme-card h3 { margin-bottom: 0.6rem; }
  .ghost-grid { display: grid; gap: 1rem; }
  .ghost-card {
    min-height: 220px;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 1.25rem;
    border: 1.5px dashed #D8D4C8;
    border-radius: 20px;
    background: transparent;
    gap: 0.7rem;
  }
  .ghost-card--cta { background: rgba(14, 122, 95, 0.05); border-style: solid; }
  .ghost-pattern { width: 72px; height: 72px; }
  .card-link { color: var(--encre); font-weight: 600; display: inline-flex; align-items: center; gap: 0.35rem; }
  .card-link:hover { color: var(--vert); }
  @keyframes heroFade {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
      align-items: center;
    }
    .featured-article { grid-template-columns: minmax(0, 1.05fr) minmax(240px, 0.75fr); align-items: center; }
    .ghost-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 1023px) {
    .hero { grid-template-columns: 1fr; }
  }
  @media (max-width: 759px) {
    .hero { padding: 3rem 0 0; }
    .hero-pattern-shell { min-height: 180px; }
    .featured-article { padding: 1rem; }
    .section-heading { align-items: start; flex-direction: column; }
    .hero-title { font-size: clamp(2rem, 8vw, 2.8rem); }
    .ticker-track { font-size: 0.68rem; }
    .hero-credibility { margin-top: 1.1rem; }
  }
</style>
