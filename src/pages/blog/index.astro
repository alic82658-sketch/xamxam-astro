---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { formatCategory } from '../../utils/formatters';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout title="Blog" description="Tous les articles sur l’IA au Sénégal, avec l’ambition de rayonner sur l’Afrique francophone.">
  <section class="container section-space">
    <h1>Blog</h1>
    <p class="lead">Guides, analyses et ressources pratiques pour mieux comprendre l’IA au Sénégal, avec l’ambition de rayonner sur l’Afrique francophone.</p>
    <div class="filters">
      <a href="/blog/categorie/outils-et-pratiques">Outils & Pratiques</a>
      <a href="/blog/categorie/ia-en-afrique">IA en Afrique</a>
    </div>
    <div class="grid">
      {articles.map((article) => (
        <ArticleCard title={article.data.title} description={article.data.description} publishDate={article.data.publishDate} category={formatCategory(article.data.category)} slug={article.id} image={article.data.image} imageAlt={article.data.imageAlt || article.data.title} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .section-space { padding-top: 3rem; }
  .filters { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1rem 0 1.5rem; }
  .filters a { padding: 0.55rem 0.8rem; border: 1px solid var(--color-border); border-radius: 999px; }
</style>
