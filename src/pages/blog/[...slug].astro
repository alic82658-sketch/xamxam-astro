---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';
import { formatCategory, formatFrenchDate } from '../../utils/formatters';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles
    .map((article) => ({
      params: { slug: article.id.replace(/\.md$/, '') },
      props: { article },
    }))
    .filter(({ params }) => params.slug && params.slug.trim().length > 0);
}

const { article } = Astro.props;
const { Content } = await render(article);
const professionLabels = {
  commercants: 'Commerçants et vendeurs',
  commerciaux: 'Commerciaux',
  'professeurs-formateurs': 'Professeurs et formateurs',
  'dirigeants-pme': 'Dirigeants de PME',
  'immobilier-meubles': 'Immobilier et meublés',
  'demandeurs-emploi': 'Demandeurs d’emploi',
};
const overlap = (left: string[] = [], right: string[] = []) => {
  const values = new Set(left.map((value) => value.toLowerCase()));
  return right.reduce((score, value) => score + (values.has(value.toLowerCase()) ? 1 : 0), 0);
};
const related = (await getCollection('articles', ({ data }) => !data.draft && data.title !== article.data.title))
  .map((item) => ({
    item,
    score: overlap(article.data.professions, item.data.professions) * 4
      + overlap(article.data.tools, item.data.tools) * 3
      + overlap(article.data.topics, item.data.topics) * 2
      + (item.data.category === article.data.category ? 1 : 0),
  }))
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score || b.item.data.publishDate.valueOf() - a.item.data.publishDate.valueOf())
  .slice(0, 3)
  .map(({ item }) => item);
---

<BaseLayout title={article.data.title} description={article.data.description} image={article.data.image} type="article" publishDate={article.data.publishDate} updateDate={article.data.updateDate} author={article.data.author}>
  <article class="container article-page">
    {article.data.image ? <img class="hero-image" src={article.data.image} alt={article.data.imageAlt || article.data.title} loading="eager" /> : null}
    <p class="pill">{formatCategory(article.data.category)}</p>
    <h1>{article.data.title}</h1>
    <div class="meta">
      <span>Par {article.data.author}</span>
      <span>Publié le {formatFrenchDate(article.data.publishDate)}</span>
      {article.data.updateDate ? <span>Mise à jour le {formatFrenchDate(article.data.updateDate)}</span> : null}
    </div>
    {article.data.professions.length > 0 ? <nav class="profession-tags" aria-label="Métiers concernés">
      <span>Utile pour :</span>
      {article.data.professions.map((profession) => (
        <a href={`/metiers/${profession}/`}>{professionLabels[profession]}</a>
      ))}
    </nav> : null}
    <div class="prose">
      <Content />
    </div>
    <div class="author-box">
      <p><strong>Par Malcom Ali Kassim</strong> — Fondateur de xamxam.ai et Teranga Web Digital.</p>
    </div>
    <WhatsAppCTA />
    {related.length > 0 ? <section class="related">
      <h2>Articles similaires</h2>
      <div class="grid three">
        {related.map((item) => (
          <a class="card related-card" href={`/blog/${item.id}/`}>
            <h3>{item.data.title}</h3>
            <p>{item.data.description}</p>
          </a>
        ))}
      </div>
    </section> : null}
  </article>
  <Fragment slot="schema">
    <SchemaOrg type="Article" article={{ headline: article.data.title, description: article.data.description, image: article.data.image, datePublished: article.data.publishDate.toISOString(), dateModified: article.data.updateDate?.toISOString() || article.data.publishDate.toISOString(), author: article.data.author }} />
  </Fragment>
</BaseLayout>

<style>
  .article-page { padding-top: 2.5rem; }
  .hero-image { width: 100%; height: auto; max-height: 420px; object-fit: cover; border-radius: var(--radius); margin-bottom: 1.5rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 1rem; color: var(--gris-texte); margin-bottom: 1.5rem; }
  .profession-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin: -0.5rem 0 1.5rem; }
  .profession-tags span { color: var(--gris-texte); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; }
  .profession-tags a { padding: 0.4rem 0.65rem; border-radius: 999px; background: var(--encre); color: white; font-size: 0.78rem; font-weight: 700; }
  .author-box { margin: 2rem 0; padding: 1rem 1.2rem; border-left: 4px solid var(--vert); background: rgba(14,122,95,0.08); border-radius: 0 8px 8px 0; }
  .related { margin-top: 2.5rem; }
  .related-card { display: block; }
</style>
