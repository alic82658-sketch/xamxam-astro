---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
---
<BaseLayout title="Contacter Xamxam" description="Proposer un sujet, signaler une correction ou présenter une solution utile au Sénégal : contactez la rédaction de Xamxam sur WhatsApp.">
  <section class="container">
    <h1>Contacter Xamxam</h1>
    <p class="lead">Un sujet à proposer, une correction ou une solution à nous faire découvrir ?</p>
    <div class="card"><p>Écrivez à la rédaction sur WhatsApp. Pour une correction, joignez le lien de la page et la source à consulter.</p><WhatsAppCTA label="Écrire à la rédaction" /></div>
  </section>
</BaseLayout>
